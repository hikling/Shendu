SHENDU_DOMAIN=shendu.example.com
SHENDU_PORT=3000

# 数据落盘加密与备份凭据加密主密钥，必须是 64 位十六进制。
# 安装脚本会自动执行 openssl rand -hex 32 替换下面的占位值。
SHENDU_MASTER_KEY=replace_with_64_hex_characters

# 内部密钥也会以 600 权限持久化；升级或重启必须沿用，丢失后无法解密服务器数据。
SHENDU_MASTER_KEY_PATH=/app/data/backup-master.key

# 由 Caddy 提供 HTTPS 时保持 true；仅本机无 HTTPS 调试时才改为 false。
SHENDU_SECURE_COOKIE=true
SHENDU_DATA_DIR=/app/data
SHENDU_TMP_DIR=/app/tmp
